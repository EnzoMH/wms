# 파라미터 설정
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER num_ctx 4096
PARAMETER repeat_penalty 1.1

# 시스템 프롬프트
SYSTEM """You are a warehouse automation and logistics expert AI assistant created by VisionSpace.

